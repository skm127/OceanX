DEBUG=false
DATA_DIR=../data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://your-production-domain.example

# AI Guide (SAGAR AI) — Gemini API key. Leave empty to use built-in fallback mode.
GEMINI_API_KEY=

# Copernicus Marine Service (CMEMS) credentials for live ocean reanalysis ingestion
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Argo GDAC ERDDAP endpoint
ARGO_ERDDAP_URL=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats

# Optional Redis Cache (fallback to high-performance in-memory TTL cache)
REDIS_URL=redis://localhost:6379/0
